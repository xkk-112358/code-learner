{
  "name": "code-learner",
  "displayName": "Code Learner",
  "description": "Open any code file as a Jupyter notebook with AI-powered cell explanations",
  "version": "0.5.0",
  "publisher": "code-learner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xkk-112358/code-learner.git"
  },
  "icon": "tb.jpg",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Notebooks",
    "Machine Learning"
  ],
  "keywords": [
    "jupyter",
    "notebook",
    "learn",
    "code",
    "explain",
    "ai",
    "ipynb"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "code-learner.openAsNotebook",
        "title": "%code-learner.openAsNotebook%"
      },
      {
        "command": "code-learner.configure",
        "title": "%code-learner.configure%"
      },
      {
        "command": "code-learner.explainCell",
        "title": "%code-learner.explainCell%",
        "icon": "$(lightbulb)"
      },
      {
        "command": "code-learner.explainCellBelow",
        "title": "%code-learner.explainCellBelow%",
        "icon": "$(add)"
      },
      {
        "command": "code-learner.explainSelected",
        "title": "%code-learner.explainSelected%"
      },
      {
        "command": "code-learner.convertAllToComments",
        "title": "%code-learner.convertAllToComments%"
      },
      {
        "command": "code-learner.deleteAtCursor",
        "title": "%code-learner.deleteAtCursor%"
      },
      {
        "command": "code-learner.reExplain",
        "title": "%code-learner.reExplain%"
      },
      {
        "command": "code-learner.deleteExplanation",
        "title": "%code-learner.deleteExplanation%"
      },
      {
        "command": "code-learner.copyQA",
        "title": "%code-learner.copyQA%"
      },
      {
        "command": "code-learner.deleteQA",
        "title": "%code-learner.deleteQA%"
      },
      {
        "command": "code-learner.askQuestion",
        "title": "%code-learner.askQuestion%"
      },
      {
        "command": "code-learner.toComment",
        "title": "%code-learner.toComment%"
      },
      {
        "command": "code-learner.copyExplanation",
        "title": "%code-learner.copyExplanation%"
      },
      {
        "command": "code-learner.translateHover",
        "title": "%code-learner.translateHover%"
      },
      {
        "command": "code-learner.showOriginalHover",
        "title": "%code-learner.showOriginalHover%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "code-learner.openAsNotebook",
          "group": "code-learner@1",
          "when": "editorLangId != 'ipynb' && editorHasSelection == false"
        },
        {
          "command": "code-learner.explainSelected",
          "group": "code-learner@2",
          "when": "editorHasSelection && (editorLangId != 'ipynb' || notebookCellExecutable == true)"
        },
        {
          "command": "code-learner.convertAllToComments",
          "group": "code-learner@3",
          "when": "editorLangId != 'ipynb'"
        },
        {
          "command": "code-learner.deleteAtCursor",
          "group": "code-learner@4",
          "when": "editorLangId != 'ipynb'"
        }
      ],
      "notebook/cell/title": [
        {
          "command": "code-learner.explainCell",
          "group": "code-learner@1"
        },
        {
          "command": "code-learner.explainCellBelow",
          "group": "code-learner@2"
        }
      ],
      "commandPalette": [
        {
          "command": "code-learner.translateHover",
          "when": "false"
        },
        {
          "command": "code-learner.showOriginalHover",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Code Learner",
      "properties": {
        "codeLearner.provider": {
          "type": "string",
          "enum": [
            "openai",
            "claude"
          ],
          "default": "openai",
          "description": "AI provider for code explanations"
        },
        "codeLearner.openaiEndpoint": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI-compatible API endpoint URL"
        },
        "codeLearner.openaiModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "OpenAI model name"
        },
        "codeLearner.claudeEndpoint": {
          "type": "string",
          "default": "https://api.anthropic.com",
          "description": "Anthropic API endpoint URL"
        },
        "codeLearner.claudeModel": {
          "type": "string",
          "default": "claude-sonnet-5",
          "description": "Claude model name"
        },
        "codeLearner.maxTokens": {
          "type": "integer",
          "default": 5000,
          "minimum": 500,
          "maximum": 8000,
          "description": "Maximum tokens per AI explanation"
        },
        "codeLearner.temperature": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 1,
          "description": "AI temperature"
        },
        "codeLearner.cacheEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Cache explanations"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.50.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
